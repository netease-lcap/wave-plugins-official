{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${WAVE_PLUGIN_ROOT}/hooks/inspect-edits.js\"",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${WAVE_PLUGIN_ROOT}/hooks/review-turn.js\"",
            "asyncRewake": true,
            "timeout": 120
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${WAVE_PLUGIN_ROOT}/hooks/review-commit.js\"",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
